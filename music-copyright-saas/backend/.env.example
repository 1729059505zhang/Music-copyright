# ==========================================
# 音乐版权SaaS平台 - 环境变量配置模板
# 使用说明：复制本文件为 .env，并修改为实际配置值
# ==========================================

# ---------- 服务配置 ----------
# 服务监听端口
PORT=3000
# 服务绑定主机
HOST=0.0.0.0
# 环境标识: development / production
NODE_ENV=development

# ---------- 数据库配置 ----------
# MySQL主机地址
DB_HOST=localhost
# MySQL端口
DB_PORT=3306
# MySQL用户名
DB_USER=root
# MySQL密码
DB_PASSWORD=123456
# MySQL数据库名
DB_NAME=music_copyright_saas
# 时区
DB_TIMEZONE=+08:00
# 连接池最小连接数
DB_POOL_MIN=5
# 连接池最大连接数
DB_POOL_MAX=20

# ---------- Redis配置 ----------
# Redis主机
REDIS_HOST=localhost
# Redis端口
REDIS_PORT=6379
# Redis密码（无密码留空）
REDIS_PASSWORD=
# Redis数据库编号
REDIS_DB=0

# ---------- JWT配置 ----------
# JWT密钥（生产环境务必修改为复杂随机字符串）
JWT_SECRET=music_copyright_saas_jwt_secret_key_2024
# JWT过期时间（秒）- 默认7天
JWT_EXPIRE=604800
# 管理后台JWT过期时间（秒）- 默认24小时
JWT_ADMIN_EXPIRE=86400

# ---------- 文件存储配置 ----------
# 存储方式: local / oss
STORAGE_TYPE=local
# 本地存储根目录
STORAGE_LOCAL_PATH=./uploads
# 访问URL前缀
STORAGE_URL_PREFIX=http://localhost:3000/uploads

# 阿里云OSS配置（STORAGE_TYPE=oss时生效）
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_REGION=oss-cn-beijing
OSS_DOMAIN=https://your-bucket.oss-cn-beijing.aliyuncs.com

# ---------- 业务配置 ----------
# 平台默认抽佣比例（百分比，整数，如10表示10%）
DEFAULT_COMMISSION_RATE=10
# 结算冻结周期（天）
SETTLEMENT_FREEZE_DAYS=7
# 最低提现金额（分）
MIN_WITHDRAWAL_AMOUNT=10000
# 提现手续费（百分比，整数）
WITHDRAWAL_FEE_RATE=1

# 音乐发行模块开关: true / false
ENABLE_RELEASE_MODULE=true
# 版权登记模块开关: true / false
ENABLE_COPYRIGHT_MODULE=true

# ---------- 第三方API配置 ----------
# 支付网关地址
PAYMENT_GATEWAY_URL=https://api.payment.example.com
# 微信支付配置
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_KEY=
# 支付宝配置
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
# 版权存证接口
COPYRIGHT_DEPOSIT_API_URL=
COPYRIGHT_DEPOSIT_API_KEY=
# 音频内容审核接口
AUDIO_AUDIT_API_URL=
AUDIO_AUDIT_API_KEY=

# ---------- 日志配置 ----------
# 日志级别: error / warn / info / debug
LOG_LEVEL=info
# 日志文件目录
LOG_DIR=./logs

# ---------- 其他 ----------
# 默认租户ID
DEFAULT_TENANT_ID=1
# CORS允许的源（多个用逗号分隔）
CORS_ORIGIN=*
